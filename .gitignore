```gitignore
# Python virtual environments
.venv/
venv/

# Environment and secrets
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]

# macOS files
.DS_Store

# Logs and temporary files
*.log
*.tmp

# Local backups
*.bak
*.bak*
*.rollback_saved
_backup_before_crossplatform/
backups/

# Generated output
out_shots/
screenshots/

# Claude temporary worktrees
.claude/worktrees/

# Generated scripts output
generated_scripts/screenshoots/
generated_scripts/fill_diagnostics/

# Temporary test artifacts
tests/*.zip
tests/_probe_out/

# Generated test screenshots and debug folders
tests/fixtures/**/shots/
tests/fixtures/**/screenshoots/
tests/fixtures/**/debug/

# Generated test reports
tests/fixtures/**/report.json

# Root-level generated test outputs
/video_run_recording.json
/video_run_report*.json

# Large archive files
_archive/root_outputs/storage.zip
